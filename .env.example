# Neon Postgres (pooled connection string). Server-only — never expose to the client.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (signed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend) — signup invites and password resets.
# Without RESEND_API_KEY, emails are logged to the server console instead.
RESEND_API_KEY=
EMAIL_FROM="Talad POS <no-reply@example.com>"
# Shown in invite emails. TODO(decision): official support address.
SUPPORT_EMAIL=support@talad.app

# Trusted-device cookie signing (falls back to BETTER_AUTH_SECRET)
DEVICE_COOKIE_SECRET=

# Supplier stock links: signs PIN-unlock cookies and salts visitor IP hashes
# (falls back to BETTER_AUTH_SECRET)
SUPPLIER_LINK_SECRET=
