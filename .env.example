# Neon Postgres (pooled connection string). Server-only — never expose to the client.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary (signed uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Password-reset email
# TODO(decision): email provider — Resend assumed (RESEND_API_KEY); without it, reset links are logged to the server console.
EMAIL_FROM="Talad POS <no-reply@example.com>"
RESEND_API_KEY=

# Trusted-device cookie signing (falls back to BETTER_AUTH_SECRET)
DEVICE_COOKIE_SECRET=
